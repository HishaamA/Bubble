# Client-safe Vite configuration. These values are embedded in the app bundle.
VITE_APP_ENV=development
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: use only when the compatible flight proxy is hosted separately
# from the Supabase project above. This URL is embedded in the client.
VITE_FLIGHT_TRACKER_ENDPOINT=

# Temporary prototype access. Standard production builds keep this false;
# `pnpm build:demo` enables it for a testable native demo.
VITE_DEMO_LOGIN_ENABLED=false

# Configure Clerk for email verification codes only: require email, enable email
# codes for sign-up/sign-in, and disable phone, password, and social providers.
# Allow personal accounts if Clerk Organizations remain enabled; Bubble family
# groups are created separately during the app's own onboarding.
# The publishable key is client-safe. Never expose CLERK_SECRET_KEY with VITE_.
# Configure Clerk and both Supabase values together for durable family access.

# Server-only Clerk configuration. Keep this in a server secret store.
CLERK_SECRET_KEY=

# Server-only Supabase/Edge Function configuration.
# Keep these in the Supabase secret store or a server-only local environment.
# Never add a VITE_ prefix to any variable below.
SUPABASE_SERVICE_ROLE_KEY=
CRON_AUTH_TOKEN=
AERODATABOX_RAPIDAPI_KEY=
APP_ALLOWED_ORIGINS=

# Family Thread provider configuration. Text-only requests originate server-side.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Generic push transport configuration. Private family content must not enter payloads.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
