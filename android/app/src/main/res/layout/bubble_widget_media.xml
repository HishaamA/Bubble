<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bubble_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bubble_widget_card_plum"
        android:clipToOutline="true">

        <LinearLayout
            android:id="@+id/bubble_widget_media_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TextView.setMinWidth is remotely callable on Android 7+ and
                 preserves width when a launcher uses an AT_MOST measure pass. -->
            <TextView
                android:id="@+id/bubble_widget_width_driver"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/bubble_widget_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="FROM YOUR FAMILY"
                android:textAllCaps="true"
                android:textColor="#F3BCCF"
                android:textSize="10sp" />

            <FrameLayout
                android:id="@+id/bubble_widget_photo_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:background="@drawable/bubble_widget_photo_frame"
                android:clipToOutline="true"
                android:padding="1dp">

                <ImageView
                    android:id="@+id/bubble_widget_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:id="@+id/bubble_widget_photo_caption"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bubble_widget_media_scrim"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/bubble_widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="Last week, together"
                        android:textColor="#FFF1D2"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/bubble_widget_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="A little look back."
                        android:textColor="#E0BEC7"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bubble_widget_play"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bubble_widget_play_plum"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="▶"
                    android:textColor="#351127"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/bubble_widget_page_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="13dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#E0BEC7"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
