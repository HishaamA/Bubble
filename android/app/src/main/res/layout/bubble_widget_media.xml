<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/bubble_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bubble_widget_card_plum"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="12dp"
        android:paddingEnd="11dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bubble_widget_eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="LAST WEEK"
                android:textAllCaps="true"
                android:textColor="#F3BCCF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bubble_widget_doodle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:text="✦  ♡"
                android:textColor="#E5ADC5"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:background="@drawable/bubble_widget_photo_frame"
            android:minHeight="38dp"
            android:padding="3dp">

            <ImageView
                android:id="@+id/bubble_widget_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/bubble_widget_play"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:background="@drawable/bubble_widget_play_plum"
                android:text="▶"
                android:textColor="#351127"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/bubble_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Last week, together"
            android:textColor="#FFF1D2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubble_widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="A little look back."
            android:textColor="#E0BEC7"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/bubble_widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="23dp"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="Remember this"
            android:textColor="#351127"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bubble_widget_badge_plum" />
    </LinearLayout>

    <TextView
        android:id="@+id/bubble_widget_tape"
        android:layout_width="48dp"
        android:layout_height="8dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bubble_widget_tape_plum"
        android:importantForAccessibility="no"
        android:text="" />
</FrameLayout>
