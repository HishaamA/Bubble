<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bubble_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bubble_widget_card_plum"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/bubble_widget_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/bubble_widget_media_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bubble_widget_media_scrim"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="9dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bubble_widget_eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="LAST WEEK"
                    android:textAllCaps="true"
                    android:textColor="#F3BCCF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bubble_widget_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bubble_widget_badge_plum"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minHeight="19dp"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="Remember this"
                    android:textColor="#351127"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/bubble_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="Last week, together"
                android:textColor="#FFF1D2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bubble_widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="A little look back."
                android:textColor="#E0BEC7"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/bubble_widget_orbit"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:alpha="0.72"
            android:background="@drawable/bubble_widget_orbit_plum"
            android:importantForAccessibility="no"
            android:text="" />

        <TextView
            android:id="@+id/bubble_widget_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bubble_widget_play_plum"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="#351127"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubble_widget_doodle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bubble_widget_play_plum"
            android:fontFamily="serif"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="✦"
            android:textColor="#351127"
            android:textSize="10sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/bubble_widget_tape"
        android:layout_width="42dp"
        android:layout_height="6dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bubble_widget_tape_plum"
        android:importantForAccessibility="no"
        android:text="" />
</FrameLayout>
