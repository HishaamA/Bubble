<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bubble_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bubble_widget_card_plum"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/bubble_widget_orbit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.22"
            android:background="@drawable/bubble_widget_orbit_plum"
            android:importantForAccessibility="no"
            android:text=""
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bubble_widget_text_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Preserve the responsive minimum width without a fixed card size. -->
            <TextView
                android:id="@+id/bubble_widget_width_driver"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bubble_widget_doodle"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bubble_widget_play_plum"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="✦"
                    android:textColor="#351127"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bubble_widget_eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="THIS WEEK"
                    android:textAllCaps="true"
                    android:textColor="#F3BCCF"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bubble_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:text="A little moment?"
                android:textColor="#FFF1D2"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/bubble_widget_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFF1D2"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bubble_widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="top"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="Take a quick photo for your family capsule."
                android:textColor="#E0BEC7"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bubble_widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bubble_widget_badge_plum"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="21dp"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Open camera"
                android:textColor="#351127"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/bubble_widget_page_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="13dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#E0BEC7"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
