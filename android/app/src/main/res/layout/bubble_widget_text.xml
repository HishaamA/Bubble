<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/bubble_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bubble_widget_card_plum"
        android:clipToOutline="true">

        <TextView
            android:id="@+id/bubble_widget_orbit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.46"
            android:background="@drawable/bubble_widget_orbit_plum"
            android:importantForAccessibility="no"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bubble_widget_eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="THIS WEEK"
                    android:textAllCaps="true"
                    android:textColor="#F3BCCF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bubble_widget_doodle"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bubble_widget_play_plum"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="✦"
                    android:textColor="#351127"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bubble_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:text="A little moment?"
                android:textColor="#FFF1D2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bubble_widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="top"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="Take a quick photo for your family capsule."
                android:textColor="#E0BEC7"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/bubble_widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bubble_widget_badge_plum"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="21dp"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Open camera"
                android:textColor="#351127"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/bubble_widget_tape"
        android:layout_width="42dp"
        android:layout_height="6dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bubble_widget_tape_plum"
        android:importantForAccessibility="no"
        android:text="" />
</FrameLayout>
